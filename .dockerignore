# Git files
.git
.gitignore
.gitattributes

# Documentation
*.md
LICENSE
docs/

# Docker files (exclude other Dockerfiles and compose files)
tools/docker/docker-compose.yaml
tools/docker/Dockerfile-*
# Primary ff-eth-logs recipe is tools/docker/Dockerfile (not matched by Dockerfile-*); keep it in context.

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Development and test files
*_test.go
**/*_test.go
testdata/
coverage.*
*.coverprofile
profile.cov
*.test
*.out
**/*mocks*/

# Build artifacts and binaries
bin/
build/
dist/
*.exe
*.exe~
*.dll
*.so
*.dylib
ff-eth-logs

# Dependencies (will be downloaded during build)
vendor/

# Go workspace files
go.work
go.work.sum

# Environment and config files (using env vars instead)
config/.env
config/.env.*

# Logs and temporary files
*.log
logs/
tmp/
temp/
*.tmp

# Local database files and dumps stay out of the context (COPY . . would put
# them in the builder stage and remote build caches). Only the tracked schema
# is re-included: the runtime image ships it so a deployment applies the
# schema the pinned image was built against.
*.db
*.sqlite
*.sql
db/
!db/init_pg_db.sql
!db/migrations/

# Parquet exports and local data volumes (backfill inputs are mounted, not baked in)
*.parquet
data/

# Scripts
tools/scripts/

# ==============================================
# FF Eth Logs - Environment Configuration
# ==============================================
# NOTE: All variables must be prefixed with FF_ETH_LOGS_
# Nested configs use dots converted to underscores (database.user → FF_ETH_LOGS_DATABASE_USER)
# Copy to config/.env.local for local overrides (git ignored).

# ----------------
# General
# ----------------
FF_ETH_LOGS_DEBUG=true
FF_ETH_LOGS_SENTRY_DSN=

# ----------------
# Database
# ----------------
FF_ETH_LOGS_DATABASE_HOST=localhost
FF_ETH_LOGS_DATABASE_PORT=5432
FF_ETH_LOGS_DATABASE_USER=postgres
FF_ETH_LOGS_DATABASE_PASSWORD=postgres
FF_ETH_LOGS_DATABASE_DBNAME=ff_eth_logs
FF_ETH_LOGS_DB_HOST_PORT=5433

# ----------------
# Ethereum (tail ingestion)
# ----------------
FF_ETH_LOGS_ETHEREUM_WEBSOCKET_URL=
FF_ETH_LOGS_ETHEREUM_INGESTION_ENABLED=true
FF_ETH_LOGS_ETHEREUM_CONFIRMATION_BLOCKS=2
FF_ETH_LOGS_ETHEREUM_MAX_CATCHUP_BLOCKS=50000
FF_ETH_LOGS_ETHEREUM_GETLOGS_SPAN_CAP=10000

# ----------------
# JSON-RPC server
# ----------------
FF_ETH_LOGS_SERVER_PORT=8545
FF_ETH_LOGS_RPC_MAX_RESULTS=100000
